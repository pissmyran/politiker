# Values for deploying PolitikerKontakt to your own Cloudflare account. Copy
# to a private file outside the repo, fill in, and render with
# tools/render.mjs (see README.md). Every __NAME__ placeholder is
# replaced with NAME. Secrets (MAIL_CRED_KEY, SYSTEM_SMTP_PASSWORD,
# TURNSTILE_SECRET, OAuth client secrets) are Worker secrets:
# `npx wrangler secret put <NAME>`.

# Host name, and the Cloudflare zone it belongs to.
PUBLIC_HOST=politiker.example.com
ZONE_NAME=example.com

# Resources: `npx wrangler d1 create` and `npx wrangler kv namespace create`.
D1_DATABASE_NAME=politiker
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
KV_SESSIONS_ID=00000000000000000000000000000000

# System e-mail (verification codes, password reset, feedback).
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=noreply@example.com
SYSTEM_FROM_ADDRESS=noreply@example.com
FEEDBACK_NOTIFY_EMAIL=feedback@example.com

# Turnstile (dashboard → Turnstile → Add site) and OAuth client ids.
TURNSTILE_HOSTNAMES=politiker.example.com
TURNSTILE_SITE_KEY=1x00000000000000000000AA
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_ID=

# Presentation: label of the "forest" theme, the browser storage key/cookie
# prefix for the theme, and an optional parent domain that sibling sites share
# the theme cookie on.
SITE_FAMILY=Skog
THEME_KEY_PREFIX=politiker
THEME_COOKIE_DOMAIN=

# Optional HTML for the FAQ: how to support the service (e.g. a donation link).
# Use @path to read it from a file.
DONATION_HTML=
