{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "politiker",
  "main": "src/access-index.ts",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "routes": [
    {
      "pattern": "__PUBLIC_HOST__",
      "custom_domain": true,
      "zone_name": "__ZONE_NAME__",
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_table": "d1_migrations",
      "migrations_dir": "../infra/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "__KV_SESSIONS_ID__"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "politiker-send-jobs",
        "binding": "SEND_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "politiker-send-jobs",
        "max_batch_size": 1,
        "max_retries": 10,
        "dead_letter_queue": "politiker-send-jobs-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "CredentialRateLimiter"
      }
    ]
  },
  "exports": {
    "CredentialRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "politiker-attachments"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "__SYSTEM_FROM_ADDRESS__"
      ]
    }
  ],
  "secrets": {
    "required": [
      "MAIL_CRED_KEY",
      "SYSTEM_SMTP_PASSWORD",
      "TURNSTILE_SECRET"
    ]
  },
  "vars": {
    "SYSTEM_SMTP_HOST": "__SYSTEM_SMTP_HOST__",
    "SYSTEM_SMTP_PORT": "__SYSTEM_SMTP_PORT__",
    "SYSTEM_SMTP_USER": "__SYSTEM_SMTP_USER__",
    "SYSTEM_FROM_ADDRESS": "__SYSTEM_FROM_ADDRESS__",
    "FEEDBACK_NOTIFY_EMAIL": "__FEEDBACK_NOTIFY_EMAIL__",
    "TURNSTILE_HOSTNAMES": "__TURNSTILE_HOSTNAMES__",
    "OAUTH_GOOGLE_CLIENT_ID": "__OAUTH_GOOGLE_CLIENT_ID__",
    "OAUTH_MICROSOFT_CLIENT_ID": "__OAUTH_MICROSOFT_CLIENT_ID__"
  }
}
